<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="@string/intro"
            android:textSize="13sp" />

        <TextView style="@style/FieldLabel" android:text="TELEGRAM API ID" />
        <EditText
            android:id="@+id/et_api_id"
            style="@style/FieldInput"
            android:hint="1234567"
            android:inputType="number" />

        <TextView style="@style/FieldLabel" android:text="TELEGRAM API HASH" />
        <EditText
            android:id="@+id/et_api_hash"
            style="@style/FieldInput"
            android:hint="0123456789abcdef0123456789abcdef"
            android:inputType="textVisiblePassword" />

        <TextView style="@style/FieldLabel" android:text="BOT TOKEN (StreamBot)" />
        <EditText
            android:id="@+id/et_bot_token"
            style="@style/FieldInput"
            android:hint="123456:ABC..."
            android:inputType="textVisiblePassword" />

        <TextView style="@style/FieldLabel" android:text="OWNER TELEGRAM USER ID" />
        <EditText
            android:id="@+id/et_owner_id"
            style="@style/FieldInput"
            android:hint="975819460"
            android:inputType="number" />

        <TextView style="@style/FieldLabel" android:text="TRACKING MONGO URI" />
        <EditText
            android:id="@+id/et_tracking_uri"
            style="@style/FieldInput"
            android:hint="mongodb+srv://user:pass@cluster/ts_tracking?..."
            android:inputType="textUri" />

        <TextView style="@style/FieldLabel" android:text="STORAGE MONGO URI" />
        <EditText
            android:id="@+id/et_storage_uri"
            style="@style/FieldInput"
            android:hint="mongodb+srv://user:pass@cluster/ts_storage?..."
            android:inputType="textUri" />

        <TextView style="@style/FieldLabel" android:text="M SEARCHER BOT USERNAME" />
        <EditText
            android:id="@+id/et_source_bot"
            style="@style/FieldInput"
            android:hint="M1searcherbot"
            android:inputType="text" />

        <TextView style="@style/FieldLabel" android:text="STAGING CHANNEL ID" />
        <EditText
            android:id="@+id/et_staging_channel"
            style="@style/FieldInput"
            android:hint="-100xxxxxxxxxx"
            android:inputType="text" />

        <TextView style="@style/FieldLabel" android:text="PORT" />
        <EditText
            android:id="@+id/et_port"
            style="@style/FieldInput"
            android:hint="8000"
            android:inputType="number" />

        <TextView style="@style/FieldLabel" android:text="BASE URL" />
        <EditText
            android:id="@+id/et_base_url"
            style="@style/FieldInput"
            android:hint="http://127.0.0.1:8000"
            android:inputType="textUri" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="10dp"
            android:text="Use this phone's LAN IP instead of 127.0.0.1 if Nuvio/Stremio runs on another device."
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/cb_external_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Enable M Searcher bridge" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Save &amp; Start Server" />

        <Button
            android:id="@+id/btn_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open Admin / Telegram Login" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop Server" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="○ Stopped"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="After starting: open Admin, log in (default admin/admin), connect the Telegram User Session, then add the addon URL to Nuvio/Stremio. The URL is shown on the admin dashboard."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

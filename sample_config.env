# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# M Searcher bridge (optional)
# The bot to query through your own Telegram user session (without @).
EXTERNAL_SEARCH="false"
EXTERNAL_BOT=""
# Private channel where fetched files are copied. The user account must be able
# to post there; the main bot must be a member so it can stream/index the copy.
STAGING_CHANNEL=""
# Prefer Tamil-labelled results, prefetch selected files, and show external
# options even when the title already exists locally.
EXTERNAL_TAMIL_FIRST="true"
EXTERNAL_PREFETCH="false"
EXTERNAL_ALWAYS="false"
# Seconds to wait for the source bot to answer (3-30).
EXTERNAL_TIMEOUT="8"
# Stream options to expose (1-20).
EXTERNAL_MAX_RESULTS="20"
# Sources per quality: 0 = show every available source (recommended for testing).
EXTERNAL_VARIANTS="0"
